{
  "name": "@avensio/async-pool",
  "version": "1.0.1",
  "description": "Run functions in an non-blocking manner, without blocking the Event-Loop",
  "type": "module",
  "main": "./dist/pool.es.js",
  "module": "./dist/pool.es.js",
  "browser": "./dist/pool.iife.js",
  "types": "./dist/pool.es.d.ts",
  "author": "Armin Kunkel",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "keywords": [
    "promise",
    "pool",
    "async",
    "concurrency",
    "avensio"
  ],
  "scripts": {
    "postinstall": "node ./scripts/hooks/commit-msg.mjs",
    "prepack": "pnpm run release",
    "release": "pnpm run test && pnpm run build && pnpm run changelog",
    "changelog": "changelogen --release --push --yes",
    "dev": "vitest --logHeapUsage --coverage",
    "build": "vite build",
    "postbuild": "node ./scripts/update.ts",
    "lint": "eslint --fix src/",
    "test": "vitest run --coverage test/",
    "docs:dev": "vitepress dev docs/ --open",
    "docs:api": "typedoc --options typedoc.config.ts src/index.ts",
    "docs:build": "pnpm docs:api && vitepress build docs/",
    "postdocs:build": "echo 'docs.avensio.de' > ./docs/.vitepress/dist/CNAME",
    "docs:preview": "vitepress preview docs/",
    "docs:pwa-assets": "pwa-assets-generator --config pwa-assets.config.ts",
    "clean": "rm -rf node_modules/ && rm -rf dist/"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvensioDev/async-pool.git"
  },
  "bugs": {
    "url": "https://github.com/AvensioDev/async-pool/issues"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@avensio/shared": "workspace:* || ^1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.9.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vite-pwa/vitepress": "^1.0.1",
    "@vitest/browser": "^4.0.6",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-frontmatter": "^1.3.0",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typedoc-plugin-mermaid": "^1.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.6"
  }
}
